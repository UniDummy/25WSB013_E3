int sensorPin = A0;
int RedLED = 5;
int YellowLED = 6;
int GreenLED = 7;
int value = 0;
float voltage = 0;

void setup() {
  Serial.begin(9600);
  pinMode(RedLED, OUTPUT);
  pinMode(YellowLED, OUTPUT);
  pinMode(GreenLED, OUTPUT);
}

void loop() {
  // reading voltage level in capacitor
  value = analogRead(sensorPin);
  voltage = (value * (5 / 1023)) - 0.1;   // to counter the voltage offset in Arduino
  
  // tracking voltage level in capacitor
  Serial.print("Voltage: ");
  Serial.println(voltage);


  // LED indication system
  if (voltage >= 1 and voltage < 3) {
    // only RED illuminate
    digitalWrite(RedLED, HIGH);
    digitalWrite(YellowLED, LOW);
  } else if (voltage >= 3 and voltage < 4.8) {
    // only YELLOW illuminate
    digitalWrite(RedLED, LOW);
    digitalWrite(YellowLED, HIGH);
    digitalWrite(GreenLED, LOW);
  } else if (voltage >= 4.8) {
    // only GREEN illuminate
    digitalWrite(YellowLED, LOW);
    digitalWrite(GreenLED, HIGH);
  }


  delay(100);   // prevent run

}
