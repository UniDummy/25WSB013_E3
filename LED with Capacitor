// setting up the LED pin
const int LED = 12;

void setup() {
  pinMode(LED, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  if (Serial.available() > 0) {
    // reading the number in Serial Monitor
    float voltage = Serial.parseFloat();
    Serial.print("What is the voltage value now?: ");
    Serial.println(voltage);
  }

  if (voltage < 0.5) {
    // meaning not charging
    digitalWrite(LED, LOW);

  } else if (voltage >= 0.5 && voltage < 4.8) {
    // meaning it is charging
    digitalWrite(LED, HIGH);
    delay(200);
    digitalWrite(LED, LOW);
    delay(200);
    digitalWrite(LED, HIGH);
    delay(200);
    digitalWrite(LED, LOW);

  } else if (voltage >= 4.8) {
    // meaning it charged up to our standard
    digitalWrite(LED, HIGH);

  }
  // saving memory
  delay(200);
}
