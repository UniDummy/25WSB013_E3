#include "BluetoothSerial.h" 
 
BluetoothSerial SerialBT; 
const int Forward_B = 4;  
const int Backward_B = 16;  
const int Left_B = 17;  
const int Right_B = 5;  
 
 
// HC-05 MAC address 
uint8_t address[6] = {0x98, 0xD3, 0x11, 0xFD, 0x51, 0x70}; 
const char* pin = "1234"; 
 
 
void setup() { 
  // Buttons setup
  pinMode(Forward_B, INPUT_PULLUP);  
  pinMode(Backward_B, INPUT_PULLUP);  
  pinMode(Left_B, INPUT_PULLUP);  
  pinMode(Right_B, INPUT_PULLUP);  
  Serial.begin(9600); 
 
 
  // Start ESP32 Bluetooth in Master Mode 
  SerialBT.begin("ESP32-Master", true);   
  SerialBT.setPin(pin,4); 
 
 
  Serial.println("Connecting to HC-05..."); 
 
 
  // Connect using classic Bluetooth SPP 
  if (SerialBT.connect(address, true)) { 
    Serial.println("CONNECTED to HC-05!"); 
  } else { 
    Serial.println("Initial connection failed. Retrying..."); 
    while (!SerialBT.connected(10000)) { 
      Serial.println("Retrying..."); 
      SerialBT.connect(address, true); 
    } 
  } 
} 
 
 
void loop() { 
  // Reading if buttons are pressed
  int Forward_state = digitalRead(Forward_B);  
  int Backward_state = digitalRead(Backward_B);  
  int Left_state = digitalRead(Left_B);  
  int Right_state = digitalRead(Right_B);  
 
  
  if (Forward_state == LOW) {  
    SerialBT.write('w');  
    //Serial.println("forward pressed")
  } else if (Backward_state == LOW) {  
    SerialBT.write('s');
    //Serial.println(("backward pressed"))
  } else if (Left_state == LOW) {  
    SerialBT.write('a');
    //Serial.println("left pressed")
  } else if (Right_state == LOW) {  
    SerialBT.write('d');
    //Serial.println("Right pressed")
  } else {
    SerialBT.write('nothing');
    //Serial.println("Nothing pressed")
  }
  delay(70);
  //if (Serial.available()) SerialBT.write(Serial.read()); 
  //if (SerialBT.available()) Serial.write(SerialBT.read()); 
} 
 
