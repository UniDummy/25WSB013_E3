#include <SoftwareSerial.h>
#include <Servo.h>

// HC-05 setup
SoftwareSerial BT(2, 3); //RX, TX

// Robot setup
Servo servoRight;
Servo servoLeft;

// Voltage reading
int sensorPin = A0;
float value = 0;
float voltage = 0;

// LED identication
int LED_1 = 6;    // LED for Coil Alignment
int LED_2 = 7;    // LED for Capacitor Voltage

// Charging rate feedback
float Rate = 0;
float charging_close = 2;   // ideal range for charging rate when perfect alignment
float charging_mid = 3;     // ideal range for charging rate when close to center
float charging_far = 4;     // ideal range for charging rate when far from center

// LED feedback (Coil Alignment)
unsigned long pre_time = 0;   // use millis() instead of delay()
const long far = 500;   // value for determining how LED falshes
const long mid = 200;
bool LED_state = LOW;


int count = 0;
float gradient_avg = 0;


//Robot Movement
//moving forward
void move_forward() {
  servoLeft.writeMicroseconds(2000);
  servoRight.writeMicroseconds(1000);
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//moving backward
void move_backward() {
  servoLeft.writeMicroseconds(1000); 
  servoRight.writeMicroseconds(2000);
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//turning right
void turn_right() {
  servoRight.writeMicroseconds(1700);  
  servoLeft.writeMicroseconds(1700);
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//turning left
void turn_left() {
  servoRight.writeMicroseconds(1300);  
  servoLeft.writeMicroseconds(1300); 
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//stop function
void stop() {
  servoRight.writeMicroseconds(1500);
  servoLeft.writeMicroseconds(1500);
}


void setup() {
  //Robot setup
  servoLeft.attach(13);
  servoRight.attach(12);

  //Serial setup
  Serial.begin(9600);
  BT.begin(9600);
  Serial.println("HC-05 is ready");
  Serial.println("w = forward, a = left, s = backward, d = right");

  //LED setup
  pinMode(LED_1, OUTPUT);
  pinMode(LED_2, OUTPUT);
}

//Main Program
void loop() {
  // Moving Robot
  if (BT.available()) {  
    char command = BT.read();  
    if (command == 'w') {
      //moving forward
      move_forward();
      Serial.println("w has received, now moving forward...");
    } else if (command == 'a') {
      //turning left
      turn_left();  
      Serial.println("a has received, now turing left...");
    } else if (command == 'd') {
      //turning right
      turn_right();  
      Serial.println("d has received, now turing right...");
    } else if (command == 's') {
      //moving backward
      move_backward();
      Serial.println("s has recevied, now moving backward...");
    } else {
      //stop
      stop();
      //Serial.println("nothing has recevied, so stop...");
    }

  } else{

    // Reading Voltage
    value = analogRead(sensorPin);
    voltage = value * (5.0 / 1023);
    Serial.print("Voltage: ");
    Serial.println(voltage, 4);


    if (voltage >= 0.1 and voltage <= 4.9) {  
      // Calculating Charging Rate
      // first measured voltage
      int t1 = millis();
      value = analogRead(sensorPin);
      float v1 = value * (5.0 / 1023);

      delay(200);   // taking reading every 200ms

      // second measured voltage
      int t2 = millis();
      value = analogRead(sensorPin);
      float v2 = value * (5.0 / 1023);


      // Calculating gradient
      int time = t2 - t1;
      float gradient = ((v2 - v1) / (time)) * 1000;


      // Calculating mean gradient
      count = 1;
      gradient_avg += gradient;
      if (count == 3) {
        gradient_avg = gradient_avg / 3;

        // logging the gradient -> graph become straight line
        Rate = -log(gradient_avg);
        Serial.print("Charging Rate: ");
        Serial.println(Rate , 4);

        // reset variable
        count = 0;
        gradient_avg = 0;
      }

      //delay(100);   // not overflow the system

      // LED feedback (Coil Alignment)
      unsigned long current_time = millis();
      
      if (Rate < charging_close) {
        // Constantly on when coil is nearly in perfect alignment
        digitalWrite(LED_1, HIGH);

      } else if (Rate >= charging_close and Rate < charging_mid) {
        // Faster flashing when coil is closer to center
        if (current_time - pre_time >= mid) {

          pre_time = current_time;

          LED_state = !LED_state;
          digitalWrite(LED_1, LED_state);
        }

      } else if (Rate >= charging_mid and Rate < charging_far) {
        // Slowly flashing when coil is far off from center
        if (current_time - pre_time >= far) {

          pre_time = current_time;

          LED_state = !LED_state;
          digitalWrite(LED_1, LED_state);
        }

      } else {
        // LED is off when either it is not charging or not even close to coil
        digitalWrite(LED_1, LOW);

      }


      // LED feedback (Capacitor Voltage)
      if (voltage >= 4.7) {
        // Only turn on when voltage level is above 4.7V
        digitalWrite(LED_2, HIGH);

      } else {
        // LED staying off otherwise
        digitalWrite(LED_2, LOW);

      }

    } else {
      // Turn off the LED once finished charging
      digitalWrite(LED_1, LOW);
      digitalWrite(LED_2, LOW);

    }
  }
}
