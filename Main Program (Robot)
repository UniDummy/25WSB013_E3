#include <SoftwareSerial.h>
#include <Servo.h>

// HC-05 setup
SoftwareSerial BT(2, 3); //RX, TX

// Robot setup
Servo servoRight;
Servo servoLeft;

// Voltage reading
int sensorPin = A0;
float value = 0;
float voltage = 0;

// LED feedback
//int RedLED = 5 ;
//int YellowLED = 6 ;
int GreenLED = 8 ;

int count = 0;
float V_avg = 0;

//Robot Movement
//moving forward
void move_forward() {
  servoLeft.writeMicroseconds(2000);
  servoRight.writeMicroseconds(1000);
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//moving backward
void move_backward() {
  servoLeft.writeMicroseconds(1000); 
  servoRight.writeMicroseconds(2000);
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//turning right
void turn_right() {
  servoRight.writeMicroseconds(1700);  
  servoLeft.writeMicroseconds(1700);
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//turning left
void turn_left() {
  servoRight.writeMicroseconds(1300);  
  servoLeft.writeMicroseconds(1300); 
  //delay(1000);
  //servoRight.writeMicroseconds(1500);
  //servoLeft.writeMicroseconds(1500);
}

//stop function
void stop() {
  servoRight.writeMicroseconds(1500);
  servoLeft.writeMicroseconds(1500);
}



void setup() {
  //Robot setup
  servoLeft.attach(13);
  servoRight.attach(12);

  //Serial setup
  Serial.begin(9600);
  BT.begin(9600);
  Serial.println("HC-05 is ready");
  Serial.println("w = forward, a = left, s = backward, d = right");

  //LED setup
  //pinMode(RedLED, OUTPUT);
  //pinMode(YellowLED, OUTPUT);
  pinMode(GreenLED, OUTPUT);
}

//Main Program
void loop() {
  // Moving Robot
  if (BT.available()) {  
    char command = BT.read();  
    if (command == 'w') {
      //moving forward
      move_forward();
      Serial.println("w has received, now moving forward...");
    } else if (command == 'a') {
      //turning left
      turn_left();  
      Serial.println("a has received, now turing left...");
    } else if (command == 'd') {
      //turning right
      turn_right();  
      Serial.println("d has received, now turing right...");
    } else if (command == 's') {
      //moving backward
      move_backward();
      Serial.println("s has recevied, now moving backward...");
    } else {
      //stop
      stop();
      //Serial.println("nothing has recevied, so stop...");
    }
  }

  // Reading Voltage
  value = analogRead(sensorPin);
  voltage = value * (5.0 / 1023);
  Serial.print("Voltage: ");
  Serial.println(voltage, 4);


  if (voltage >= 0.3 and voltage <= 4.9) {

    // Comparing Charging Rate
    // first measured voltage
    int t1 = millis();
    value = analogRead(sensorPin);
    float v1 = value * (5.0 / 1023);
    //Serial.print("V1: ");
    //Serial.println(v1, 4);

    delay(200);

    // second measured voltage
    int t2 = millis();
    value = analogRead(sensorPin);
    float v2 = value * (5.0 / 1023);
    //Serial.print("V2: ");
    //Serial.println(v2, 4);

    // v_det gradient
    int time = t2 - t1;
    float v_det = ((v2 - v1) / (time)) * 1000;

    // mean v_det
    count = count + 1;
    V_avg = V_avg + v_det;
    if (count == 3) {
      V_avg = V_avg / 3;
      count = 0;
      Serial.print("Charging Rate: ");
      Serial.println(V_avg , 4);
      V_avg = 0;
    }

    // LED feedback
    if (voltage >= 4.8) {
      // Green LED light up when voltage >= 4.8
      digitalWrite(GreenLED, HIGH);
    }

    delay(100);   // not overflow the system


  }

}
